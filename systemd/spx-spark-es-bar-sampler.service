[Unit]
Description=SPX Spark independent canonical ES five-minute bar sampler
After=network-online.target spx-spark-schwab-marketdata.service spx-spark-ibkr-stream.service
Wants=network-online.target spx-spark-schwab-marketdata.service spx-spark-ibkr-stream.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/spx-spark
EnvironmentFile=-/home/ubuntu/spx-spark/.env
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/home/ubuntu/spx-spark/scripts/run-es-bar-sampler.sh --mark-starting
ExecStart=/home/ubuntu/spx-spark/scripts/run-es-bar-sampler.sh --interval-seconds=5 --lock-path=%t/spx-spark-es-bar-sampler.lock
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
SuccessExitStatus=0
UMask=0077
CPUWeight=900
IOWeight=900

[Install]
WantedBy=default.target
