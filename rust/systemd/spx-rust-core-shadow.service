[Unit]
Description=SPX Spark Rust normalized-data shadow core
After=local-fs.target
RequiresMountsFor=/srv/data/spx-spark/rust-core-shadow/frames
ConditionPathExists=/opt/spx-spark-core-shadow/current/bin/spx-core
ConditionPathExists=/etc/spx-spark-core-shadow/core.toml
ConditionPathIsDirectory=/srv/data/spx-spark/rust-core-shadow/frames

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
RuntimeDirectory=spx-spark-core-shadow
RuntimeDirectoryMode=0700
StateDirectory=spx-spark-core-shadow
StateDirectoryMode=0700
ConfigurationDirectory=spx-spark-core-shadow
ConfigurationDirectoryMode=0750
Environment=RUST_LOG=info
ExecStartPre=/opt/spx-spark-core-shadow/current/bin/spx-core check-config --config /etc/spx-spark-core-shadow/core.toml
ExecStart=/opt/spx-spark-core-shadow/current/bin/spx-core serve --config /etc/spx-spark-core-shadow/core.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/data/spx-spark/rust-core-shadow/frames
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
