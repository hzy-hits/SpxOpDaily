[Unit]
Description=SPX Spark Rust raw-frame archive and retention
After=local-fs.target
RequiresMountsFor=/srv/data/spx-spark/rust-core-shadow
ConditionPathExists=/opt/spx-spark-core-shadow/current/bin/spx-core
ConditionPathExists=/etc/spx-spark-core-shadow/core.toml
ConditionPathIsDirectory=/srv/data/spx-spark/rust-core-shadow/frames

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
TimeoutStartSec=6h
ExecStart=/opt/spx-spark-core-shadow/current/bin/spx-core archive-frames --config /etc/spx-spark-core-shadow/core.toml --backlog-days 7 --archive-root /srv/data/spx-spark/rust-core-shadow/archive
ExecStart=/opt/spx-spark-core-shadow/current/bin/spx-core prune-frames --config /etc/spx-spark-core-shadow/core.toml --keep-completed-days 1 --max-total-bytes 2147483648 --require-archive-root /srv/data/spx-spark/rust-core-shadow/archive
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/data/spx-spark/rust-core-shadow
ReadWritePaths=/srv/data/spx-spark/rust-core-shadow/frames
ReadWritePaths=-/srv/data/spx-spark/rust-core-shadow/archive
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
