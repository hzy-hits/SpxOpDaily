[Unit]
Description=SPX Spark experimental realtime regime and range signal
After=spx-spark-market-features-hot.service
Wants=spx-spark-market-features-hot.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/spx-spark
EnvironmentFile=-/home/ubuntu/spx-spark/.env
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/spx-spark/.venv/bin/spx-spark-market-regime-signal --interval-seconds=5
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
SuccessExitStatus=0
UMask=0077
CPUWeight=200
IOWeight=200

[Install]
WantedBy=default.target
