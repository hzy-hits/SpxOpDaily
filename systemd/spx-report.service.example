# EXAMPLE ONLY. This unit has not been installed or enabled. The checked-in
# TOML keeps writer.network_enabled=false, so --allow-network alone is not
# enough to call DeepSeek.
[Unit]
Description=SPX Spark Rust half-hour GTH/RTH desk report writer (example)
Requires=spx-core.service
After=network-online.target spx-core.service
Wants=network-online.target
ConditionPathExists=/opt/spx-spark-core/bin/spx-report
ConditionPathExists=/etc/spx-spark-core/report.toml
ConditionPathExists=/etc/spx-spark-core/report.env

[Service]
Type=simple
User=spx-spark
Group=spx-spark
UMask=0077
StateDirectory=spx-spark-report
ConfigurationDirectory=spx-spark-core
Environment=RUST_LOG=info
EnvironmentFile=/etc/spx-spark-core/report.env
ExecStartPre=/opt/spx-spark-core/bin/spx-report check-config --config /etc/spx-spark-core/report.toml
ExecStart=/opt/spx-spark-core/bin/spx-report run --config /etc/spx-spark-core/report.toml --allow-network
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/spx-spark-core/latest
ReadWritePaths=/var/lib/spx-spark-core/ledger /var/lib/spx-spark-report
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=32

[Install]
WantedBy=multi-user.target
