---
config:
  theme: base
  layout: dagre
  htmlLabels: false
  themeVariables:
    fontFamily: 'Arial, PingFang SC, Microsoft YaHei, sans-serif'
    fontSize: '16px'
    primaryTextColor: '#18344d'
    lineColor: '#607487'
    clusterBkg: '#f8fafc'
    clusterBorder: '#cbd5e1'
  flowchart:
    wrappingWidth: 280
    curve: linear
    nodeSpacing: 30
    rankSpacing: 45
---
flowchart TB
    subgraph CLOUD["云端 · 开发与交付"]
      DEV["开发者 / 云端 Agent"] -->|提交 PR| CI["GitHub Actions<br/>测试 + 原生 AMD64 / ARM64 构建"]
      CI --> ART["Releases + GHCR<br/>同一提交 · 校验值 · 镜像 digest"]
    end
    subgraph ORACLE["ORACLE · 生产"]
      RUN["既有 systemd 服务<br/>Python + Rust · ARM64 原生包"] --> HOT[("在线状态 + 近期报价")]
    end
    subgraph HOME["家庭 · 调度、研究与保存"]
      PI["树莓派<br/>Prefect + 元数据 + 归档 Worker"] -->|流式传输 + 核验| NAS[("NAS<br/>核验快照 + 结果备份")]
      NAS -->|固定数据集| LAP["Linux 笔记本<br/>固定镜像 + /srv/research"]
      LAP -->|结果 + 回执| NAS
      PI -.->|调度| LAP
    end
    MAC["Mac<br/>审阅 + 按需研究"] -.->|审阅| DEV
    MAC -.->|操作| PI
    ART -->|预构建 ARM64 包| RUN
    ART -->|同提交 AMD64 镜像| LAP
    HOT -->|通过 Tailscale 只读拉取| PI
    class DEV,CI,ART cloud
    class RUN,HOT live
    class PI,MAC control
    class NAS,LAP store

    classDef cloud fill:#e9f2ff,stroke:#477bb5,color:#173a61
    classDef live fill:#e4f5f0,stroke:#378c77,color:#153f35
    classDef control fill:#f0eaff,stroke:#9272c5,color:#3f2f60
    classDef store fill:#fff4d9,stroke:#b89335,color:#5a4513
    classDef warn fill:#fff0ec,stroke:#c77b62,color:#713f30
