config:
  theme: base
  layout: dagre
  htmlLabels: false
  themeVariables:
    fontFamily: 'Arial, PingFang SC, Microsoft YaHei, sans-serif'
    fontSize: '16px'
    primaryTextColor: '#18344d'
    lineColor: '#607487'
    clusterBkg: '#f8fafc'
    clusterBorder: '#cbd5e1'
  flowchart:
    wrappingWidth: 280
    curve: linear
    nodeSpacing: 30
    rankSpacing: 45
---
flowchart TB
    BROKER["Schwab RTH / IBKR GTH + fallback"] --> INGEST["Python collectors<br/>Contracts · providers · field clocks"]
    INGEST --> RAW[("Original broker observations<br/>Availability timestamps")]
    INGEST --> LIVE["Normalized latest state"]
    subgraph PY["PYTHON · strategy authority"]
      DEC["build_strategy_decision<br/>Final manual-candidate authority"] --> DB[("Python operational database")]
      DB --> MANUAL["Existing manual lane<br/>Huey + notification records"]
      DB --> PROJ["Desk Map projection<br/>Committed decision + current-time checks"]
    end
    LIVE --> DEC
    LIVE --> PROJ
    MANUAL --> HUMAN["Human review<br/>No automated orders"]
    subgraph RS["RUST · scheduled reporting"]
      BRIDGE["Bridge"] --> CORE["Typed readiness + frames"]
      CORE --> REPORT["Half-hour + recovery reports"]
      REPORT --> LEDGER[("Rust ledger + report outbox")]
      LEDGER --> DELIVERY["Delivery + per-target receipts"]
    end
    LIVE --> BRIDGE
    PROJ -->|desk_map_projection.v1| BRIDGE
    DELIVERY --> HUMAN
    CORE -.->|Health| MONITOR["Existing Worker monitor"]
    REPORT -.->|Freshness| MONITOR
    MONITOR --> ALERT["Direct fault / recovery alerts"]
    RAW --> RESEARCH["Isolated historical research<br/>Current code + causal inputs"]
    class BROKER,INGEST,LIVE,DEC,DB,MANUAL,PROJ live
    class BRIDGE,CORE,REPORT,LEDGER,DELIVERY cloud
    class MONITOR,ALERT control
    class RAW,RESEARCH store
    class HUMAN warn

    classDef cloud fill:#e9f2ff,stroke:#477bb5,color:#173a61
    classDef live fill:#e4f5f0,stroke:#378c77,color:#153f35
    classDef control fill:#f0eaff,stroke:#9272c5,color:#3f2f60
    classDef store fill:#fff4d9,stroke:#b89335,color:#5a4513
    classDef warn fill:#fff0ec,stroke:#c77b62,color:#713f30
