[Unit]
Description=SPX Spark read-only SPXW session replay API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/spx-spark
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=SPX_SPARK_DISABLE_DOTENV=1
Environment=MARKET_DATA_DATA_ROOT=/srv/data/spx-spark/data
Environment=SPX_SURFACE_REPLAY_FRAME_MINUTES=5
Environment=SPX_CORE_SOCKET_PATH=/srv/data/spx-spark/data/published/spxw-surface/runtime/replay-api.sock
ExecStartPre=/usr/bin/install -d -m 0700 /srv/data/spx-spark/data/published/spxw-surface/runtime
ExecStart=/home/ubuntu/spx-spark/.venv/bin/uvicorn spx_spark.web.replay_api:create_default_app --factory --uds /srv/data/spx-spark/data/published/spxw-surface/runtime/replay-api.sock --no-access-log
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
MemoryHigh=2G
MemoryMax=3G
TasksMax=64
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/data/spx-spark/data/published/spxw-surface

[Install]
WantedBy=default.target
