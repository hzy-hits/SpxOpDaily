[Unit]
Description=SPX Spark persistent streaming IBKR collector
After=network-online.target
Wants=network-online.target
# Never give up on reconnect after crashes or session conflicts.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/spx-spark
EnvironmentFile=-/home/ubuntu/spx-spark/.env
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Process-level override: EnvironmentFile values otherwise win over ordinary
# Environment= entries and could restore a too-aggressive conflict loop.
# Keep initial and max equal at 15s so 10197 probes retry quickly after an
# external Live session releases entitlement.
ExecStart=/usr/bin/env IBKR_CONFLICT_PROBE_SECONDS=15 IBKR_CONFLICT_PROBE_MAX_SECONDS=15 /home/ubuntu/spx-spark/.venv/bin/spx ibkr stream --force
Restart=always
RestartSec=15
# IBKR is an always-on independent validation/hot-option lane. The process
# still detects session conflicts and reconnects with backoff.

[Install]
WantedBy=default.target
