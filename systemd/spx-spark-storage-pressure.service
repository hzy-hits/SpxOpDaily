[Unit]
Description=Check SPX Spark storage pressure without bypassing artifact verification
After=local-fs.target
RequiresMountsFor=/srv/data/spx-spark/data
ConditionPathExists=/home/ubuntu/spx-spark/scripts/run-session-finalize.sh

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/spx-spark
EnvironmentFile=-/home/ubuntu/spx-spark/.env
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/spx-spark/scripts/run-session-finalize.sh --date auto --json --pressure-check
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/data/spx-spark/data
ReadWritePaths=/srv/data/spx-spark/logs
ReadWritePaths=/srv/data/spx-spark/runtime
RestrictAddressFamilies=AF_UNIX
