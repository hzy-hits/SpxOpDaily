[Unit]
Description=Compact market decision summary on exchange-local GTH/RTH quarter hours

[Timer]
# Evening GTH belongs to the next trading day.
OnCalendar=Sun,Mon..Thu *-*-* 20:15,30,45:00 America/New_York
OnCalendar=Sun,Mon..Thu *-*-* 21..23:00,15,30,45:00 America/New_York
# Morning GTH plus the full 09:30-15:45 RTH heartbeat schedule.
OnCalendar=Mon..Fri *-*-* 00..08:00,15,30,45:00 America/New_York
OnCalendar=Mon..Fri *-*-* 09:00,15,30,45:00 America/New_York
OnCalendar=Mon..Fri *-*-* 10..15:00,15,30,45:00 America/New_York
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
